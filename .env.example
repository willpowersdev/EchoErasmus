# Copy to .env for local experimentation, or set these as AWS Lambda
# environment variables in production. Never commit the real key.

# Required
OPENAI_API_KEY=your_openai_api_key_here

# gpt-5-mini answers in ~2-3s versus ~4-5s for gpt-5, which matters because
# Alexa gives up at roughly 8 seconds. Swap to gpt-5 here if you want the
# quality ceiling and can live with occasional timeouts.
OPENAI_MODEL=gpt-5-mini

# Optional
LOG_LEVEL=info
MAX_RESPONSE_CHARACTERS=5000

# Reasoning effort for the Responses API: none | minimal | low | medium | high.
# Alexa only waits ~8 seconds, so keep this low unless you have measured latency.
OPENAI_REASONING_EFFORT=low

# Per-request timeout in milliseconds, clamped to 1000-9000.
OPENAI_TIMEOUT_MS=7500

# Set to true only while debugging: voice queries may contain private information.
LOG_PROMPTS=false
